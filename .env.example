GEMINI_API_KEY=your-gemini-api-key
MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=your-tavily-api-key  # only needed when SEARCH_SOURCE=live
SEARCH_SOURCE=sample  # sample or live
# DB_PATH=data/homefinder.db  # optional: where saved documents and extractions live
# DEMO_MODE=1            # public demo: saved Chennai search and saved answers, no search or extraction calls
# DEMO_SESSION_RUNS=3    # demo runs per browser session
# DEMO_DAILY_RUNS=50     # demo runs per UTC day, all visitors
